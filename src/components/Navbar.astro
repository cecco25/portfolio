---
import Link from '@components/link.vue';

const links = [
	{ href: '#projects', label: 'Projects', cta: false },
	{ href: '#about', label: 'About', cta: false },
	{ href: '#contact', label: 'Contact', cta: false },
	{ href: '/resume.pdf', label: 'Resume', cta: true },
];
---

<header class='w-full'>
	<nav class='flex flex-col md:flex-row w-full md:items-center justify-between'>
		<a
			href='/'
			class='font-display text-2xl tracking-tighter text-primary hover:underline transition-colors'
			aria-label='Go to homepage'
		>
			Michael Cecchini
		</a>

		<div
			class='py-4 w-full shadow-sm md:static md:block md:w-auto md:bg-transparent md:p-0 md:shadow-none'
			id='menu-panel'
			data-open='false'
		>
			<ul class='flex flex-col items-start md:flex-row md:items-center gap-1 sm:gap-2'>
				{
					links.map((link) => (
						<li>
							<Link href={link.href} cta={link.cta}>
								{link.label}
							</Link>
						</li>
					))
				}
			</ul>
		</div>
	</nav>
</header>

<script>
	const toggle = document.querySelector('#menu-toggle');
	const panel = document.querySelector('#menu-panel');

	if (toggle && panel) {
		toggle.addEventListener('click', () => {
			const isOpen = toggle.getAttribute('aria-expanded') === 'true';
			toggle.setAttribute('aria-expanded', String(!isOpen));
			panel.setAttribute('data-open', String(!isOpen));

			if (!isOpen) {
				panel.classList.remove('hidden');
			} else {
				panel.classList.add('hidden');
			}
		});

		const mediaQuery = window.matchMedia('(min-width: 768px)');
		const syncMenuState = () => {
			if (mediaQuery.matches) {
				panel.classList.remove('hidden');
				panel.setAttribute('data-open', 'true');
				toggle.setAttribute('aria-expanded', 'true');
			} else {
				panel.classList.add('hidden');
				panel.setAttribute('data-open', 'false');
				toggle.setAttribute('aria-expanded', 'false');
			}
		};

		syncMenuState();
		mediaQuery.addEventListener('change', syncMenuState);
	}
</script>
