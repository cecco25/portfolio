<main class="h-full flex">
  <div
    class="self-end flex flex-col-reverse lg:flex-col gap-4 md:max-w-[80%] my-auto lg:my-0 py-4"
  >
    <p
      id="hero-sub"
      class="text-(--text-muted) [&_strong]:text-(--text-color) text-sm sm:text-lg opacity-0"
    >
      Turning ideas into <strong>real web products</strong>.
    </p>
    <h1
      id="hero-title"
      class="text-4xl sm:text-6xl md:text-8xl lg:text-[100px]/[120px] mt-1 overflow-hidden"
      aria-label="Full-Stack Developer building for the modern web"
    >
      Full-Stack Developer building for the modern web
    </h1>
  </div>
</main>

<script>
  import { gsap } from 'gsap';
import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(SplitText);

  const title = document.getElementById('hero-title') as HTMLElement;
  const sub = document.getElementById('hero-sub') as HTMLElement;

  const split = new SplitText(title, { type: 'chars,words' });

  const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

  tl.from(split.chars, {
    y: '110%',
    opacity: 0,
    duration: 0.8,
    stagger: 0.025,
  }).to(sub, { opacity: 1, duration: 0.6 }, '-=0.3');
</script>
