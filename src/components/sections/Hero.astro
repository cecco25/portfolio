---
import GridBg from '../ui/grid-bg.vue';
---

<section id='hero' class='relative flex min-h-screen flex-col justify-between overflow-hidden py-6'>
	<GridBg />

	<div class='my-auto flex flex-col-reverse gap-4 py-8 px-8 md:max-w-[85%] lg:flex-col'>
		<p id='hero-sub' class='text-muted [&_strong]:text-body-text text-sm opacity-0 sm:text-lg'>
			Turning ideas into <strong>real web products</strong>.
		</p>
		<h1
			id='hero-title'
			class='mt-1 overflow-hidden text-4xl sm:text-6xl md:text-8xl lg:text-[100px]/[120px]'
			aria-label='Full-Stack Developer building for the modern web'
		>
			<span aria-hidden='true'
				>Full-Stack Developer building for the <span class='text-primary'>modern web</span></span
			>
		</h1>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { splitTitleChars } from '@lib/split-title';

	const title = document.getElementById('hero-title') as HTMLElement;
	const sub = document.getElementById('hero-sub') as HTMLElement;

	const chars = splitTitleChars(title);

	const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

	tl.from(chars, {
		y: '110%',
		opacity: 0,
		duration: 0.8,
	}).to(sub, { opacity: 1, duration: 0.6 }, '-=0.3');
</script>
