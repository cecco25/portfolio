---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import BookOpen from 'phosphor-astro/BookOpen.astro';
import Brain from 'phosphor-astro/Brain.astro';
import Code from 'phosphor-astro/Code.astro';
import Cpu from 'phosphor-astro/Cpu.astro';
import Gamepad2 from 'phosphor-astro/GameController.astro';
import MusicNote from 'phosphor-astro/MusicNote.astro';

interface Icon {
	name: string;
	icon: AstroComponentFactory;
	type: 'passion' | 'interest';
}

const icons: Icon[] = [
	{ name: 'Web Development', icon: Code, type: 'passion' },
	{ name: 'Software Engineering', icon: Cpu, type: 'passion' },
	{ name: 'Learning', icon: Brain, type: 'passion' },
	{ name: 'Reading', icon: BookOpen, type: 'interest' },
	{ name: 'Gaming', icon: Gamepad2, type: 'interest' },
	{ name: 'Music', icon: MusicNote, type: 'interest' },
];

const passions = icons.filter((icon) => icon.type === 'passion');
const interests = icons.filter((icon) => icon.type === 'interest');
---

<div class='flex flex-col gap-10 md:col-span-5'>
	<div>
		<h3 class='mb-2 font-display tracking-widest text-secondary uppercase'>Passions</h3>
		<ul>
			{passions.map((icon) => {
				const IconComponent = icon.icon;

				return (
					<li class='about-row group flex items-center gap-4 border-b border-body-text/10 py-2.5 last:border-b-0'>
						<IconComponent
							width={18}
							height={18}
							class='shrink-0 text-secondary'
							aria-hidden='true'
						/>
						<span class='transition-colors group-hover:text-primary'>{icon.name}</span>
					</li>
				);
			})}
		</ul>
	</div>

	<div>
		<h3 class='mb-2 font-display tracking-widest text-secondary uppercase'>Interests</h3>
		<ul>
			{interests.map((icon) => {
				const IconComponent = icon.icon;

				return (
					<li class='about-row group flex items-center gap-4 border-b border-body-text/10 py-2.5 last:border-b-0'>
						<IconComponent
							width={18}
							height={18}
							class='shrink-0 text-secondary'
							aria-hidden='true'
						/>
						<span class='transition-colors group-hover:text-primary'>{icon.name}</span>
					</li>
				);
			})}
		</ul>
	</div>
</div>
