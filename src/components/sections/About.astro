---
import Avatar from '@components/common/Avatar.astro';
import ArrowRight from 'phosphor-astro/ArrowRight.astro';
---

<section id='about' class='section py-16 px-8'>
	<div class='max-w-5xl mx-auto w-full' id='about-content'>
		<h2 class='title'>About Me</h2>

		<div class='flex md:flex-row flex-col-reverse items-center mt-8 gap-10'>
			<div class='md:col-span-7'>
				<p class='text-xl leading-snug md:text-2xl'>
					<span class='font-display text-primary'>Hi, I’m Michael Cecchini</span> — a junior
					full-stack developer and computer science student at the University of Perugia.
				</p>

				<a
					href='/about'
					class='group mt-6 inline-flex items-center gap-2 font-display text-sm tracking-widest text-secondary uppercase transition-colors hover:text-primary'
				>
					Education &amp; experience
					<ArrowRight
						width={14}
						height={14}
						class='transition-transform duration-300 group-hover:translate-x-1'
					/>
				</a>
			</div>
			<Avatar />
		</div>
	</div>

	<script>
		import { revealSection } from '@lib/scroll-reveal';

		revealSection({ containerSelector: '#about-content', rowSelector: '.about-row' });
	</script>
</section>
