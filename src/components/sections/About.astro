---
import ArrowRight from 'phosphor-astro/ArrowRight.astro';
import Code from 'phosphor-astro/Code.astro';
import Brain from 'phosphor-astro/Brain.astro';
import BookOpen from 'phosphor-astro/BookOpen.astro';
import Cpu from 'phosphor-astro/Cpu.astro';
import Gamepad2 from 'phosphor-astro/GameController.astro';
import MusicNote from 'phosphor-astro/MusicNote.astro';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

interface Icon {
	name: string;
	icon: AstroComponentFactory;
	type: 'passion' | 'interest';
}

const icons: Icon[] = [
	{ name: 'Web Development', icon: Code, type: 'passion' },
	{ name: 'Software Engineering', icon: Cpu, type: 'passion' },
	{ name: 'Learning', icon: Brain, type: 'passion' },
	{ name: 'Reading', icon: BookOpen, type: 'interest' },
	{ name: 'Gaming', icon: Gamepad2, type: 'interest' },
	{ name: 'Music', icon: MusicNote, type: 'interest' },
];

const passions = icons.filter((icon) => icon.type === 'passion');
const interests = icons.filter((icon) => icon.type === 'interest');
---

<section id='about' class='section py-16 px-8'>
	<div class='max-w-5xl mx-auto w-full' id='about-content'>
		<h2 class='title'>About Me</h2>

		<div class='grid mt-8 gap-10 md:grid-cols-12 md:gap-16'>
			<div class='md:col-span-7'>
				<p class='text-xl leading-snug md:text-2xl'>
					<span class='font-display text-primary'>Hi, I'm Michael Cecchini</span> — a junior full-stack
					developer and computer science student at the University of Perugia.
				</p>

				<div class='mt-6 space-y-4 leading-relaxed text-muted'>
					<p>
						I am passionate about building modern web applications, working across both the frontend
						and backend. Over the years, I've developed projects using modern technologies like
						React, Next.js, Laravel, and Node.js, while managing data with MySQL and PostgreSQL.
					</p>
					<p>
						In addition to my studies to broaden my knowledge in the technology world, I work on
						real-world web applications and open-source starter templates.
					</p>
				</div>

				<a
					href='/about'
					class='group mt-6 inline-flex items-center gap-2 font-display text-sm tracking-widest text-secondary uppercase transition-colors hover:text-primary'
				>
					Education &amp; experience
					<ArrowRight
						width={14}
						height={14}
						class='transition-transform duration-300 group-hover:translate-x-1'
					/>
				</a>
			</div>

			<div class='flex flex-col gap-10 md:col-span-5'>
				<div>
					<h3 class='mb-2 font-display tracking-widest text-secondary uppercase'>Passions</h3>
					<ul>
						{
							passions.map((icon, i) => {
								const IconComponent = icon.icon;

								return (
									<li class='about-row group flex items-center gap-4 border-b border-body-text/10 py-2.5 last:border-b-0'>
										<span class='font-display text-xs text-body-text/30 transition-colors group-hover:text-primary'>
											{String(i + 1).padStart(2, '0')}
										</span>
										<IconComponent width={18} height={18} class='shrink-0 text-secondary' />
										<span class='transition-colors group-hover:text-primary'>{icon.name}</span>
									</li>
								);
							})
						}
					</ul>
				</div>

				<div>
					<h3 class='mb-2 font-display tracking-widest text-secondary uppercase'>Interests</h3>
					<ul>
						{
							interests.map((icon, i) => {
								const IconComponent = icon.icon;

								return (
									<li class='about-row group flex items-center gap-4 border-b border-body-text/10 py-2.5 last:border-b-0'>
										<span class='font-display text-xs text-body-text/30 transition-colors group-hover:text-primary'>
											{String(i + 1).padStart(2, '0')}
										</span>
										<IconComponent width={18} height={18} class='shrink-0 text-secondary' />
										<span class='transition-colors group-hover:text-primary'>{icon.name}</span>
									</li>
								);
							})
						}
					</ul>
				</div>
			</div>
		</div>
	</div>

	<script>
		import { gsap } from 'gsap';
		import { ScrollTrigger } from 'gsap/ScrollTrigger';
		gsap.registerPlugin(ScrollTrigger);

		const aboutContent = document.getElementById('about-content') as HTMLElement;
		const rows = gsap.utils.toArray<HTMLElement>('.about-row');

		gsap.fromTo(
			aboutContent,
			{ opacity: 0, y: 50 },
			{
				opacity: 1,
				y: 0,
				scrollTrigger: {
					trigger: aboutContent,
					start: 'top 90%',
					end: 'top 50%',
					scrub: true,
				},
			},
		);

		gsap.fromTo(
			rows,
			{ opacity: 0, x: 24 },
			{
				opacity: 1,
				x: 0,
				stagger: 0.08,
				scrollTrigger: {
					trigger: aboutContent,
					start: 'top 80%',
					end: 'top 30%',
					scrub: true,
				},
			},
		);
	</script>
</section>
