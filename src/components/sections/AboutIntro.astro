---
import MapPin from 'phosphor-astro/MapPin.astro';
import GraduationCap from 'phosphor-astro/GraduationCap.astro';
import Briefcase from 'phosphor-astro/Briefcase.astro';
import GridBg from '../ui/grid-bg.vue';

const badges = [
	{ label: 'Perugia, Italy', icon: MapPin },
	{ label: 'BSc Computer Science', icon: GraduationCap },
	{ label: 'Full Stack @ MicrowebPG', icon: Briefcase },
];
---

<section
	id='about-hero'
	class='relative overflow-hidden min-h-screen px-8 pt-24 pb-16 md:pt-32 md:pb-20'
>
	<GridBg />

	<div class='mx-auto max-w-5xl'>
		<p
			id='about-eyebrow'
			class='font-display text-xs tracking-widest text-secondary uppercase opacity-0'
		>
			// About Me
		</p>

		<h1
			id='about-title'
			class='mt-4 overflow-hidden text-4xl sm:text-5xl md:text-6xl lg:text-[68px]/[1.1]'
			aria-label='Hi, I’m Michael — junior full-stack developer.'
		>
			<span aria-hidden='true'>
				Hi, I’m Michael — junior <span class='text-primary'>full-stack developer.</span>
			</span>
		</h1>

		<p
			id='about-sub'
			class='mt-7 max-w-2xl text-base leading-relaxed text-muted opacity-0 md:text-lg'
		>
			I’m a junior full-stack developer and Computer Science student at the University of Perugia. I
			like turning ideas into working products — across the frontend and backend — using React,
			Next.js, Laravel, and Node.js, with PostgreSQL and MySQL doing the heavy lifting underneath.
			Outside of coursework I build real-world apps and open-source starter templates, and I’m
			always curious to learn new things.
		</p>

		<div id='about-badges' class='mt-8 flex flex-wrap gap-3 opacity-0'>
			{badges.map((badge) => {
				const IconComponent = badge.icon;
				return (
					<span class='inline-flex items-center gap-2 rounded-full border border-body-text/10 px-4 py-2 text-sm text-body-text/80 [&_svg]:h-3.5 [&_svg]:w-3.5 [&_svg]:shrink-0 [&_svg]:text-secondary'>
						<IconComponent width={14} height={14} aria-hidden='true' />
						{badge.label}
					</span>
				);
			})}
		</div>
	</div>
</section>

<script>
	import { splitTitleChars } from '@lib/split-title';
	import { gsap } from 'gsap';

	const title = document.getElementById('about-title') as HTMLElement;
	const eyebrow = document.getElementById('about-eyebrow') as HTMLElement;
	const sub = document.getElementById('about-sub') as HTMLElement;
	const badges = document.getElementById('about-badges') as HTMLElement;

	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		gsap.set([eyebrow, sub, badges], { opacity: 1 });
	} else {
		const chars = splitTitleChars(title);

		const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

		tl.to(eyebrow, { opacity: 1, duration: 0.5 })
			.from(chars, { y: '110%', opacity: 0, duration: 0.8, stagger: 0.01 }, '-=0.2')
			.to(sub, { opacity: 1, duration: 0.6 }, '-=0.3')
			.to(badges, { opacity: 1, duration: 0.6 }, '-=0.4');
	}
</script>
