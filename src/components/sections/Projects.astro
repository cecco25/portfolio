---
import GithubLogo from 'phosphor-astro/GithubLogo.astro';
import ArrowUpRight from 'phosphor-astro/ArrowUpRight.astro';

interface Project {
	title: string;
	year: string;
	description: string;
	stack: string[];
	github?: string;
	live?: string;
}

const projects: Project[] = [
	{
		title: 'Nimbus',
		year: '2025',
		description:
			'A self-hosted file sync service with end-to-end encryption, built as a lightweight alternative to third-party cloud storage for small teams.',
		stack: ['Next.js', 'Node.js', 'PostgreSQL', 'AWS S3'],
		github: 'https://github.com/mcecchini/nimbus',
		live: 'https://nimbus.example.com',
	},
	{
		title: 'PulseBoard',
		year: '2024',
		description:
			'A realtime analytics dashboard streaming live metrics over WebSockets, backed by a Redis pub/sub layer for sub-second updates.',
		stack: ['React', 'Node.js', 'Redis', 'WebSockets'],
		github: 'https://github.com/mcecchini/pulseboard',
		live: 'https://pulseboard.example.com',
	},
	{
		title: 'Forma',
		year: '2024',
		description:
			'A headless CMS starter kit for freelancers, pairing a Laravel API with a Vue admin panel and role-based access control.',
		stack: ['Laravel', 'MySQL', 'Vue'],
		github: 'https://github.com/mcecchini/forma',
	},
	{
		title: 'Codex CLI',
		year: '2023',
		description:
			'An open-source command-line tool that scaffolds full-stack starter templates in seconds, built to speed up my own project setup.',
		stack: ['TypeScript', 'Node.js', 'Commander'],
		github: 'https://github.com/mcecchini/codex-cli',
	},
];
---

<section id='projects' class='section py-16'>
	<div class='max-w-5xl mx-auto w-full' id='projects-content'>
		<h2 class='title'>Projects</h2>

		<ul class='mt-8'>
			{
				projects.map((project, i) => (
					<li class='project-row group relative -mx-4 rounded-lg border-t border-body-text/10 px-4 py-8 transition-colors first:border-t-0 hover:bg-body-text/3 md:grid md:grid-cols-12 md:items-center md:gap-6'>
						<span class='font-display text-2xl text-primary/40 transition-colors duration-300 group-hover:text-primary md:col-span-1 md:text-3xl'>
							{String(i + 1).padStart(2, '0')}
						</span>

						<div class='md:col-span-7'>
							<div class='mb-2 flex flex-wrap items-center gap-3'>
								<h3 class='text-xl font-bold transition-colors group-hover:text-primary md:text-2xl'>
									{project.title}
								</h3>
								<span class='font-display text-xs text-muted'>{project.year}</span>
							</div>
							<p class='max-w-md text-sm leading-relaxed text-muted md:text-base'>
								{project.description}
							</p>
						</div>

						<div class='mt-4 flex flex-wrap gap-2 md:col-span-3 md:mt-0'>
							{project.stack.map((tech) => (
								<span class='rounded border border-secondary/20 px-2 py-1 font-display text-[11px] uppercase tracking-wider text-secondary'>
									{tech}
								</span>
							))}
						</div>

						<div class='mt-4 flex items-center gap-4 md:col-span-1 md:mt-0 md:justify-end'>
							{project.github && (
								<a
									href={project.github}
									target='_blank'
									rel='noopener noreferrer'
									aria-label={`View ${project.title} on GitHub`}
									class='text-muted transition-colors hover:text-primary'
								>
									<GithubLogo width={20} height={20} />
								</a>
							)}
							{project.live && (
								<a
									href={project.live}
									target='_blank'
									rel='noopener noreferrer'
									aria-label={`View live demo of ${project.title}`}
									class='text-muted transition-colors hover:text-primary'
								>
									<ArrowUpRight
										width={20}
										height={20}
										class='transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5'
									/>
								</a>
							)}
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const rows = gsap.utils.toArray<HTMLElement>('.project-row');

	gsap.fromTo(
		rows,
		{ opacity: 0, y: 40 },
		{
			opacity: 1,
			y: 0,
			stagger: 0.12,
			duration: 0.6,
			ease: 'power2.out',
			scrollTrigger: {
				trigger: '#projects-content',
				start: 'top 85%',
				end: 'top 30%',
				scrub: true,
			},
		},
	);
</script>
