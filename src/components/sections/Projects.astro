---
import { getCollection } from 'astro:content';
import ArrowUpRight from 'phosphor-astro/ArrowUpRight.astro';
import GithubLogo from 'phosphor-astro/GithubLogo.astro';
import TechIcon from '@components/ui/tech-icon.astro';

interface Project {
	title: string;
	description: string;
	stack: string[];
	href: string;
	external?: boolean;
}

const HOME_STACK_SIZE = 3;

const openSource: Project[] = [
	{
		title: 'Next.js Starter Template',
		description:
			'A boilerplate template for kicking off new projects fast, wired up with Better-Auth for authentication and a PostgreSQL database out of the box.',
		stack: ['Next.js', 'Better-Auth', 'PostgreSQL'],
		href: 'https://github.com/MicrowebPG/nextjs-template',
		external: true,
	},
];

const caseStudies = (await getCollection('projects'))
	.sort((a, b) => a.data.order - b.data.order)
	.map(({ id, data }) => ({
		title: data.title,
		description: data.description,
		stack: data.stack.slice(0, HOME_STACK_SIZE),
		href: `/projects/${id}`,
	}));

const projects: Project[] = [...openSource, ...caseStudies];
const iconClass =
	'text-muted transition-[color,transform] duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-primary';
---

<section id='projects' class='section py-16 px-8'>
	<div class='max-w-5xl mx-auto w-full' id='projects-content'>
		<h2 class='title'>Projects</h2>

		<ul class='mt-8'>
			{projects.map((project) => (
				<li class='project-row -mx-4 border-t border-body-text/10 first:border-t-0'>
					<a
						href={project.href}
						target={project.external ? '_blank' : undefined}
						rel={project.external ? 'noopener noreferrer' : undefined}
						class='group block rounded-lg px-4 py-8 transition-colors hover:bg-body-text/3 focus-visible:bg-body-text/3 focus-visible:outline-2 focus-visible:outline-primary md:grid md:grid-cols-12 md:items-center md:gap-6'
					>
						<div class='md:col-span-8'>
							<h3 class='mb-2 text-xl font-bold transition-colors group-hover:text-primary md:text-2xl'>
								{project.title}
							</h3>
							<p class='max-w-md text-sm leading-relaxed text-muted md:text-base'>
								{project.description}
							</p>
						</div>

						<div class='mt-4 flex flex-wrap items-center gap-3 md:col-span-3 md:mt-0'>
							{project.stack.map((tech) => (
								<TechIcon tech={tech} />
							))}
						</div>

						<div class='mt-4 flex items-center md:col-span-1 md:mt-0 md:justify-end'>
							{project.external ? (
								<>
									<GithubLogo width={20} height={20} aria-hidden='true' class={iconClass} />
									<span class='sr-only'>(opens GitHub in a new tab)</span>
								</>
							) : (
								<ArrowUpRight width={20} height={20} aria-hidden='true' class={iconClass} />
							)}
						</div>
					</a>
				</li>
			))}
		</ul>
	</div>
</section>

<script>
	import { revealSection } from '@lib/scroll-reveal';

	revealSection({ containerSelector: '#projects-content', rowSelector: '.project-row' });
</script>
